# Copy this file to .env and fill in your values.

PORT=3000
NODE_ENV=development
# Public address of the shop (used in emails, sitemap and social previews)
BASE_URL=http://localhost:3000

# Long random string — keeps login sessions secure. Change it in production!
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account (created automatically on first start if no admin exists)
ADMIN_EMAIL=admin@komaira.com
ADMIN_PASSWORD=ChangeMe123!

# Where data is stored
DATABASE_PATH=./data/komaira.db
UPLOAD_DIR=./uploads

# Online payments via Razorpay (optional — Cash on Delivery works without it)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional — without SMTP, emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Komaira Boutique <hello@komaira.com>"
