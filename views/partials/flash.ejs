<% if (flash && (flash.success || flash.error)) { %>
  <div class="flash-wrap container">
    <% if (flash.success) { %><div class="flash flash-success" role="status"><%- include('icon', { name: 'check', size: 18 }) %><span><%= flash.success %></span></div><% } %>
    <% if (flash.error) { %><div class="flash flash-error" role="alert"><span><%= flash.error %></span></div><% } %>
  </div>
<% } %>
