<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} | ${settings.store_name}` : `${settings.store_name} — ${settings.tagline}` %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta property="og:site_name" content="<%= settings.store_name %>">
  <meta property="og:title" content="<%= title || settings.store_name %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= baseUrl + ogImage %>"><% } %>
  <link rel="canonical" href="<%= baseUrl + currentPath %>">
  <link rel="icon" href="/public/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body data-csrf="<%= csrfToken %>">
<a class="skip-link" href="#main">Skip to content</a>
<%
  const announcements = settings.announcement_active === '1'
    ? String(settings.announcement_text || '').split('\n').map((s) => s.trim()).filter(Boolean) : [];
%>
<% if (announcements.length) { %>
<div class="announcement" data-rotator>
  <div class="container announcement-inner">
    <% announcements.forEach((a, i) => { %>
      <% if (settings.announcement_link) { %>
        <a href="<%= h.safeLink(settings.announcement_link) %>" class="announcement-item<%= i === 0 ? ' is-active' : '' %>"><%= a %></a>
      <% } else { %>
        <span class="announcement-item<%= i === 0 ? ' is-active' : '' %>"><%= a %></span>
      <% } %>
    <% }) %>
  </div>
</div>
<% } %>

<header class="site-header" data-header>
  <div class="container header-inner">
    <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-open><%- include('icon', { name: 'menu', size: 22 }) %></button>

    <a href="/" class="logo" aria-label="<%= settings.store_name %> home">
      <span class="logo-mark">Komaira</span><span class="logo-sub">Boutique</span>
    </a>

    <nav class="main-nav" data-menu aria-label="Main">
      <div class="menu-head">
        <span class="logo-mark">Komaira</span>
        <button class="icon-btn" type="button" aria-label="Close menu" data-menu-close><%- include('icon', { name: 'close', size: 22 }) %></button>
      </div>
      <ul>
        <li><a href="/shop" class="<%= currentPath === '/shop' ? 'is-current' : '' %>">Shop all</a></li>
        <% navCategories.slice(0, 6).forEach((c) => { %>
          <li class="<%= c.children.length ? 'has-children' : '' %>">
            <a href="/category/<%= c.slug %>" class="<%= currentPath === '/category/' + c.slug ? 'is-current' : '' %>"><%= c.name %></a>
            <% if (c.children.length) { %>
              <ul class="submenu">
                <% c.children.forEach((sc) => { %><li><a href="/category/<%= sc.slug %>"><%= sc.name %></a></li><% }) %>
              </ul>
            <% } %>
          </li>
        <% }) %>
        <li><a href="/shop?sale=1" class="nav-sale">Offers</a></li>
      </ul>
      <div class="menu-foot">
        <a href="<%= customer ? '/account' : '/account/login' %>"><%= customer ? 'My account' : 'Sign in' %></a>
        <a href="/track-order">Track order</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" aria-label="Search" data-search-open><%- include('icon', { name: 'search' }) %></button>
      <a class="icon-btn hide-sm" href="<%= customer ? '/account' : '/account/login' %>" aria-label="Account"><%- include('icon', { name: 'user' }) %></a>
      <a class="icon-btn hide-sm" href="/account/wishlist" aria-label="Wishlist"><%- include('icon', { name: 'heart' }) %></a>
      <a class="icon-btn bag-btn" href="/cart" aria-label="Shopping bag">
        <%- include('icon', { name: 'bag' }) %>
        <span class="bag-count<%= cartCount ? '' : ' is-empty' %>" data-cart-count><%= cartCount %></span>
      </a>
    </div>
  </div>

  <div class="search-panel" data-search-panel hidden>
    <form class="container search-form" action="/shop" method="get" role="search">
      <%- include('icon', { name: 'search', size: 22 }) %>
      <input type="search" name="q" placeholder="Search for lipstick, serum, sunscreen…" aria-label="Search products" value="<%= query.q || '' %>" autocomplete="off">
      <button type="button" class="icon-btn" aria-label="Close search" data-search-close><%- include('icon', { name: 'close' }) %></button>
    </form>
  </div>
</header>
<div class="menu-backdrop" data-menu-backdrop hidden></div>

<main id="main">
<%- include('flash') %>
