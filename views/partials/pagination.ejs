<% if (pager.pages > 1) { %>
<nav class="pagination" aria-label="Pages">
  <% if (pager.page > 1) { %><a href="<%= h.queryWith(query, { page: pager.page - 1 }) %>" aria-label="Previous page"><%- include('icon', { name: 'chevron-left', size: 18 }) %></a><% } %>
  <% for (let i = 1; i <= pager.pages; i++) { %>
    <% if (i === 1 || i === pager.pages || Math.abs(i - pager.page) <= 2) { %>
      <a href="<%= h.queryWith(query, { page: i }) %>" class="<%= i === pager.page ? 'is-current' : '' %>" <%= i === pager.page ? 'aria-current=page' : '' %>><%= i %></a>
    <% } else if (Math.abs(i - pager.page) === 3) { %><span>…</span><% } %>
  <% } %>
  <% if (pager.page < pager.pages) { %><a href="<%= h.queryWith(query, { page: pager.page + 1 }) %>" aria-label="Next page"><%- include('icon', { name: 'chevron-right', size: 18 }) %></a><% } %>
</nav>
<% } %>
