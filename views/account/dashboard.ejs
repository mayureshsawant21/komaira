<%- include('../partials/head') %>
<section class="container narrow-top">
  <div class="account-head">
    <div>
      <h1 class="page-title">Hello, <%= profile.name.split(' ')[0] %></h1>
      <p class="muted"><%= profile.email %></p>
    </div>
    <div class="account-links">
      <a href="/account/wishlist" class="btn btn-outline btn-sm"><%- include('../partials/icon', { name: 'heart', size: 16 }) %> Wishlist</a>
      <form action="/account/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-sm" type="submit">Sign out</button></form>
    </div>
  </div>

  <div class="account-grid">
    <div class="card">
      <h2>Your orders</h2>
      <% if (!orders.length) { %>
        <p class="muted">You haven't placed any orders yet.</p>
        <a href="/shop" class="btn btn-primary btn-sm">Start shopping</a>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th></tr></thead>
            <tbody>
              <% orders.forEach((o) => { %>
                <tr>
                  <td><a href="/order/<%= encodeURIComponent(o.order_number) %>"><%= o.order_number %></a></td>
                  <td><%= h.formatDate(o.created_at) %></td>
                  <td><%= o.item_count %></td>
                  <td><%= money(o.total) %></td>
                  <td><span class="status status-<%= o.status %>"><%= o.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <form class="card" id="profile" action="/account/profile" method="post">
      <h2>Details & address</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <label class="field"><span>Name</span><input name="name" required value="<%= profile.name %>"></label>
        <label class="field"><span>Mobile</span><input name="phone" type="tel" value="<%= profile.phone || '' %>"></label>
      </div>
      <label class="field"><span>Address</span><input name="address_line1" value="<%= profile.address_line1 || '' %>"></label>
      <label class="field"><span>Area, landmark</span><input name="address_line2" value="<%= profile.address_line2 || '' %>"></label>
      <div class="form-grid form-grid-3">
        <label class="field"><span>City</span><input name="city" value="<%= profile.city || '' %>"></label>
        <label class="field"><span>State</span><input name="state" value="<%= profile.state || '' %>"></label>
        <label class="field"><span>PIN code</span><input name="pincode" value="<%= profile.pincode || '' %>"></label>
      </div>
      <button class="btn btn-primary btn-sm" type="submit">Save details</button>
    </form>

    <form class="card" id="password" action="/account/password" method="post">
      <h2>Change password</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Current password</span><input name="current_password" type="password" required autocomplete="current-password"></label>
      <label class="field"><span>New password</span><input name="new_password" type="password" required minlength="8" autocomplete="new-password"></label>
      <button class="btn btn-outline btn-sm" type="submit">Update password</button>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
