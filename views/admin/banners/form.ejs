<%- include('../partials/top') %>
<% const b = banner; const isNew = !b.id; const dt = (v) => (v ? String(v).slice(0, 16).replace(' ', 'T') : ''); %>
<div class="page-head"><div><a href="/admin/banners" class="back">← Banners</a><h1><%= isNew ? 'New banner slide' : 'Edit banner slide' %></h1></div></div>
<%- include('../partials/errors') %>

<div class="banner-preview banner-preview-lg text-<%= b.text_theme %> align-<%= b.align %>" style="--slide-bg: <%= b.bg_color %>" data-banner-preview>
  <img src="<%= b.image || '' %>" alt="" data-bp-img <%= b.image ? '' : 'hidden' %>>
  <div class="banner-preview-text">
    <small data-bp="eyebrow"><%= b.eyebrow || '' %></small>
    <strong data-bp="title"><%= b.title || 'Your headline' %></strong>
    <span data-bp="subtitle"><%= b.subtitle || '' %></span>
    <span class="mini-cta" data-bp="cta_text" <%= b.cta_text ? '' : 'hidden' %>><%= b.cta_text || '' %></span>
  </div>
  <span class="preview-label">Live preview</span>
</div>

<form action="<%= isNew ? '/admin/banners' : `/admin/banners/${b.id}` %>" method="post" enctype="multipart/form-data" class="form-layout" data-banner-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-main">
    <section class="card">
      <h2>Text</h2>
      <label class="field"><span>Small text above headline</span><input name="eyebrow" maxlength="80" value="<%= b.eyebrow || '' %>" placeholder="e.g. Diwali sale · Limited time"></label>
      <label class="field"><span>Headline *</span><input name="title" required maxlength="140" value="<%= b.title || '' %>" placeholder="e.g. Flat 30% off all lipsticks"></label>
      <label class="field"><span>Supporting text</span><textarea name="subtitle" rows="2" maxlength="300" placeholder="e.g. Use code GLOW30 at checkout. Ends Sunday."><%= b.subtitle || '' %></textarea></label>
      <div class="field-row">
        <label class="field"><span>Button text</span><input name="cta_text" maxlength="40" value="<%= b.cta_text || '' %>" placeholder="Shop now"></label>
        <label class="field"><span>Button link</span><input name="cta_link" value="<%= b.cta_link || '' %>" placeholder="/category/makeup or /shop?sale=1"><small>A page in your store (starts with /) or a full https:// link</small></label>
      </div>
    </section>
    <section class="card">
      <h2>Images</h2>
      <p class="hint">Desktop: a wide image around 1920 × 800 px. Mobile (optional): a tall image around 800 × 1000 px. Without an image, the background colour is used with a soft glow.</p>
      <div class="field-row">
        <div>
          <strong class="small">Desktop image</strong>
          <% if (b.image) { %><div class="image-grid"><div class="image-tile wide"><img src="<%= b.image %>" alt=""><label class="check"><input type="checkbox" name="remove_image"> Remove</label></div></div><% } %>
          <label class="dropzone"><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" data-preview="#bp-desktop" data-banner-image><span><strong>Upload</strong> desktop image</span></label>
          <div class="image-grid" id="bp-desktop"></div>
        </div>
        <div>
          <strong class="small">Mobile image (optional)</strong>
          <% if (b.mobile_image) { %><div class="image-grid"><div class="image-tile"><img src="<%= b.mobile_image %>" alt=""><label class="check"><input type="checkbox" name="remove_mobile_image"> Remove</label></div></div><% } %>
          <label class="dropzone"><input type="file" name="mobile_image" accept="image/jpeg,image/png,image/webp,image/avif" data-preview="#bp-mobile"><span><strong>Upload</strong> mobile image</span></label>
          <div class="image-grid" id="bp-mobile"></div>
        </div>
      </div>
    </section>
  </div>
  <aside class="form-side">
    <section class="card">
      <h2>Look</h2>
      <label class="field"><span>Background colour</span><input type="color" name="bg_color" value="<%= b.bg_color || '#f3e6e1' %>"></label>
      <label class="field"><span>Text colour</span>
        <select name="text_theme"><option value="dark" <%= b.text_theme === 'dark' ? 'selected' : '' %>>Dark text (for light images)</option><option value="light" <%= b.text_theme === 'light' ? 'selected' : '' %>>White text (for dark images)</option></select>
      </label>
      <label class="field"><span>Text position</span>
        <select name="align"><% ['left', 'center', 'right'].forEach((a) => { %><option value="<%= a %>" <%= b.align === a ? 'selected' : '' %>><%= a.charAt(0).toUpperCase() + a.slice(1) %></option><% }) %></select>
      </label>
    </section>
    <section class="card">
      <h2>Schedule</h2>
      <label class="check big"><input type="checkbox" name="is_active" <%= b.is_active ? 'checked' : '' %>> Active</label>
      <label class="field mt"><span>Start showing (optional)</span><input type="datetime-local" name="starts_at" value="<%= dt(b.starts_at) %>"></label>
      <label class="field"><span>Stop showing (optional)</span><input type="datetime-local" name="ends_at" value="<%= dt(b.ends_at) %>"><small>Great for time-limited offers. Times are India time (IST).</small></label>
      <label class="field"><span>Position</span><input type="number" name="sort_order" value="<%= b.sort_order || 0 %>"><small>Lower numbers show first</small></label>
    </section>
    <div class="sticky-actions"><button type="submit" class="btn btn-primary btn-block">Save slide</button></div>
  </aside>
</form>
<%- include('../partials/bottom') %>
