<%- include('partials/top') %>
<div class="page-head"><div><h1>Messages</h1><p class="muted">Sent through the Contact page.</p></div></div>
<% if (!messages.length) { %>
  <div class="card empty"><p>No messages yet.</p></div>
<% } else { %>
<div class="review-admin-list">
  <% messages.forEach((m) => { %>
    <article class="card review-admin <%= m.is_read ? 'is-read' : 'is-unread' %>">
      <div>
        <strong><%= m.subject || 'Message' %></strong> <% if (!m.is_read) { %><span class="pill pill-pending">New</span><% } %>
        <p class="pre"><%= m.body %></p>
        <small class="muted"><%= m.name %> · <a href="mailto:<%= m.email %>?subject=<%= encodeURIComponent('Re: ' + (m.subject || 'Your message')) %>"><%= m.email %></a><%= m.phone ? ` · ${m.phone}` : '' %> · <%= h.formatDate(m.created_at, true) %></small>
      </div>
      <div class="row-actions">
        <a class="btn btn-xs btn-primary" href="mailto:<%= m.email %>?subject=<%= encodeURIComponent('Re: ' + (m.subject || 'Your message')) %>">Reply</a>
        <form action="/admin/messages/<%= m.id %>/read" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs"><%= m.is_read ? 'Mark unread' : 'Mark read' %></button></form>
        <form action="/admin/messages/<%= m.id %>/delete" method="post" data-confirm="Delete this message?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs btn-danger-text">Delete</button></form>
      </div>
    </article>
  <% }) %>
</div>
<% } %>
<%- include('partials/bottom') %>
