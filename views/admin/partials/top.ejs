<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Admin · <%= settings.store_name %></title>
  <link rel="icon" href="/public/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="admin" data-csrf="<%= csrfToken %>">
<%
  const nav = [
    ['dashboard', '/admin', 'Dashboard', 'grid'],
    ['orders', '/admin/orders', 'Orders', 'bag', badges.orders],
    ['products', '/admin/products', 'Products', 'tag'],
    ['categories', '/admin/categories', 'Categories', 'folder'],
    ['banners', '/admin/banners', 'Banners & offers', 'image'],
    ['coupons', '/admin/coupons', 'Coupons', 'ticket'],
    ['customers', '/admin/customers', 'Customers', 'users'],
    ['reviews', '/admin/reviews', 'Reviews', 'star', badges.reviews],
    ['analytics', '/admin/analytics', 'Visitors', 'chart'],
    ['messages', '/admin/messages', 'Messages', 'mail', badges.messages],
    ['subscribers', '/admin/subscribers', 'Subscribers', 'send'],
    ['pages', '/admin/pages', 'Pages', 'file'],
    ['settings', '/admin/settings', 'Settings', 'cog'],
  ];
  const icons = {
    grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    bag: '<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
    tag: '<path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
    folder: '<path d="M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z"/>',
    image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>',
    ticket: '<path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4V8Z"/><path d="M10 6v12" stroke-dasharray="2 2"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .7 3.5 2.8 3.5 6"/>',
    star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>',
    chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
    send: '<path d="m3 11 18-8-8 18-2-8-8-2Z"/>',
    file: '<path d="M6 3h8l5 5v13H6V3Z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>',
    cog: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
  };
%>
<div class="admin-shell">
  <aside class="sidebar" data-sidebar>
    <a href="/admin" class="brand"><span>Komaira</span><small>Admin</small></a>
    <nav aria-label="Admin">
      <% nav.forEach(([key, href, label, icon, badge]) => { %>
        <a href="<%= href %>" class="<%= section === key ? 'is-active' : '' %>" <%= section === key ? 'aria-current=page' : '' %>>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[icon] %></svg>
          <span><%= label %></span>
          <% if (badge) { %><em class="nav-badge"><%= badge %></em><% } %>
        </a>
      <% }) %>
    </nav>
    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">View store ↗</a>
      <form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="linklike">Sign out</button></form>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-sidebar-close hidden></div>

  <div class="admin-main">
    <header class="topbar">
      <button type="button" class="menu-btn" data-sidebar-open aria-label="Open navigation">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <span class="topbar-title"><%= title %></span>
      <span class="topbar-user"><%= admin.name %></span>
    </header>
    <div class="content">
      <% if (flash.success) { %><div class="alert alert-success" role="status"><%= flash.success %></div><% } %>
      <% if (flash.error) { %><div class="alert alert-error" role="alert"><%= flash.error %></div><% } %>
