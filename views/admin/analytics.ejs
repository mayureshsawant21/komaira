<%- include('partials/top') %>
<%
  const t = data.totals;
  const perVisitor = t.visitors ? (t.views / t.visitors).toFixed(1) : '0';
  const typeLabels = { home: 'Home', product: 'Product', category: 'Category', shop: 'Shop', search: 'Search', cart: 'Bag', checkout: 'Checkout', page: 'Page', contact: 'Contact', account: 'Account', order: 'Order', wishlist: 'Wishlist', 'track-order': 'Tracking' };
  const maxOf = (rows, key) => Math.max(1, ...rows.map((r) => r[key]));
%>
<div class="page-head">
  <div><h1>Visitors & analytics</h1><p class="muted">Every storefront page view is counted. Your own visits while signed in to admin are not.</p></div>
  <div class="tabs tabs-compact">
    <% Object.entries(ranges).forEach(([d, label]) => { %><a href="/admin/analytics?days=<%= d %>" class="<%= Number(d) === days ? 'is-active' : '' %>"><%= label %></a><% }) %>
  </div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-label">Live now</span><strong class="stat-value"><span class="live-dot" aria-hidden="true"></span><%= live %></strong><span class="stat-sub">last 5 minutes</span></div>
  <div class="stat"><span class="stat-label">Unique visitors</span><strong class="stat-value"><%= t.visitors %></strong><span class="stat-sub"><%= t.new_visitors %> first-time</span></div>
  <div class="stat"><span class="stat-label">Page views</span><strong class="stat-value"><%= t.views %></strong><span class="stat-sub"><%= perVisitor %> pages per visitor</span></div>
  <div class="stat"><span class="stat-label">Returning visitors</span><strong class="stat-value"><%= Math.max(0, t.visitors - t.new_visitors) %></strong><span class="stat-sub">came back again</span></div>
</div>

<% if (days > 1) { %>
<section class="card">
  <div class="card-head"><h2>Unique visitors per day</h2>
    <details class="table-toggle"><summary>Show as table</summary>
      <div class="table-wrap"><table class="table compact"><thead><tr><th>Day</th><th>Visitors</th><th>Page views</th></tr></thead>
      <tbody><% data.daily.slice().reverse().forEach((d) => { %><tr><td><%= d.day %></td><td><%= d.visitors %></td><td><%= d.views %></td></tr><% }) %></tbody></table></div>
    </details>
  </div>
  <div class="chart-box"><canvas id="chart-traffic" role="img" aria-label="Bar chart of unique visitors per day"></canvas></div>
</section>
<script type="application/json" id="analytics-data"><%- JSON.stringify(data.daily).replace(/</g, '\\u003c') %></script>
<% } %>

<section class="card flush">
  <div class="card-head padded"><h2>Visitors by page</h2><span class="muted small"><%= data.pages.length %> pages visited</span></div>
  <% if (!data.pages.length) { %><p class="muted padded">No visits recorded in this period yet. Share your store link to get your first visitors!</p><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Page</th><th>Type</th><th class="num">Unique visitors</th><th class="num">Page views</th><th>Last visit</th></tr></thead>
    <tbody>
      <% const maxV = maxOf(data.pages, 'visitors'); data.pages.forEach((p) => { %>
        <tr>
          <td><a href="<%= p.path %>" target="_blank" rel="noopener"><strong><%= p.title || p.path %></strong></a><br><small class="muted"><%= p.path %></small></td>
          <td><span class="pill"><%= typeLabels[p.page_type] || p.page_type %></span></td>
          <td class="num"><span class="bar-cell"><span class="bar" style="width: <%= Math.round((p.visitors / maxV) * 100) %>%"></span><span><%= p.visitors %></span></span></td>
          <td class="num"><%= p.views %></td>
          <td><small><%= h.formatDate(p.last_seen, true) %></small></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>

<div class="grid-2">
  <section class="card">
    <h2>Most viewed products</h2>
    <% if (!data.products.length) { %><p class="muted">No product views yet.</p><% } else { %>
    <ol class="rank-list"><% data.products.forEach((p) => { %><li><a href="/admin/products/<%= p.id %>/edit"><%= p.name %></a><span><%= p.visitors %> visitor<%= p.visitors === 1 ? "" : "s" %> · <%= p.views %> view<%= p.views === 1 ? "" : "s" %></span></li><% }) %></ol>
    <% } %>
  </section>
  <section class="card">
    <h2>Most viewed categories</h2>
    <% if (!data.categories.length) { %><p class="muted">No category views yet.</p><% } else { %>
    <ol class="rank-list"><% data.categories.forEach((c) => { %><li><a href="/category/<%= c.slug %>" target="_blank" rel="noopener"><%= c.name %></a><span><%= c.visitors %> visitor<%= c.visitors === 1 ? "" : "s" %> · <%= c.views %> view<%= c.views === 1 ? "" : "s" %></span></li><% }) %></ol>
    <% } %>
  </section>
</div>

<div class="grid-3">
  <section class="card">
    <h2>Where visitors come from</h2>
    <% if (!data.referrers.length) { %><p class="muted">No data yet.</p><% } else { const m = maxOf(data.referrers, 'visitors'); %>
    <ul class="hbar-list"><% data.referrers.forEach((r) => { %><li><span class="hbar-label"><%= r.source %></span><span class="hbar"><span style="width: <%= Math.round((r.visitors / m) * 100) %>%"></span></span><span class="hbar-val"><%= r.visitors %></span></li><% }) %></ul>
    <% } %>
  </section>
  <section class="card">
    <h2>Devices</h2>
    <% if (!data.devices.length) { %><p class="muted">No data yet.</p><% } else { const m = maxOf(data.devices, 'visitors'); %>
    <ul class="hbar-list"><% data.devices.forEach((r) => { %><li><span class="hbar-label"><%= r.device %></span><span class="hbar"><span style="width: <%= Math.round((r.visitors / m) * 100) %>%"></span></span><span class="hbar-val"><%= r.visitors %></span></li><% }) %></ul>
    <% } %>
  </section>
  <section class="card">
    <h2>Browsers</h2>
    <% if (!data.browsers.length) { %><p class="muted">No data yet.</p><% } else { const m = maxOf(data.browsers, 'visitors'); %>
    <ul class="hbar-list"><% data.browsers.forEach((r) => { %><li><span class="hbar-label"><%= r.browser %></span><span class="hbar"><span style="width: <%= Math.round((r.visitors / m) * 100) %>%"></span></span><span class="hbar-val"><%= r.visitors %></span></li><% }) %></ul>
    <% } %>
  </section>
</div>

<section class="card">
  <h2>Latest activity</h2>
  <% if (!recent.length) { %><p class="muted">Nothing yet.</p><% } else { %>
  <div class="table-wrap"><table class="table compact">
    <thead><tr><th>When</th><th>Page</th><th>Visitor</th><th>Device</th><th>From</th></tr></thead>
    <tbody><% recent.forEach((v) => { %>
      <tr><td><small><%= h.formatDate(v.created_at, true) %></small></td><td><a href="<%= v.path %>" target="_blank" rel="noopener"><%= v.title || v.path %></a></td>
        <td><small class="muted">#<%= v.visitor_id.slice(0, 6) %><%= v.is_new ? ' · new' : '' %></small></td><td><small><%= v.device %> · <%= v.browser %></small></td><td><small><%= v.referrer || '—' %></small></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/bottom', { charts: days > 1 }) %>
