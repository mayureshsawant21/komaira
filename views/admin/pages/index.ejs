<%- include('../partials/top') %>
<div class="page-head">
  <div><h1>Pages</h1><p class="muted">Information pages linked in your store's footer.</p></div>
  <div class="actions"><a href="/admin/pages/new" class="btn btn-primary">+ New page</a></div>
</div>
<div class="card flush"><div class="table-wrap"><table class="table">
  <thead><tr><th>Title</th><th>Address</th><th>Status</th><th>Updated</th><th></th></tr></thead>
  <tbody><% pages.forEach((p) => { %>
    <tr><td><a href="/admin/pages/<%= p.id %>/edit"><strong><%= p.title %></strong></a></td><td><a href="/pages/<%= p.slug %>" target="_blank" rel="noopener">/pages/<%= p.slug %></a></td>
      <td><span class="pill pill-<%= p.is_active ? 'active' : 'draft' %>"><%= p.is_active ? 'Published' : 'Hidden' %></span></td><td><%= h.formatDate(p.updated_at) %></td>
      <td class="row-actions"><a href="/admin/pages/<%= p.id %>/edit">Edit</a></td></tr>
  <% }) %></tbody>
</table></div></div>
<%- include('../partials/bottom') %>
