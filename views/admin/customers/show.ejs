<%- include('../partials/top') %>
<% const c = customer; %>
<div class="page-head"><div><a href="/admin/customers" class="back">← Customers</a><h1><%= c.name %></h1><p class="muted">Customer since <%= h.formatDate(c.created_at) %></p></div></div>
<div class="form-layout">
  <div class="form-main">
    <section class="card">
      <h2>Orders</h2>
      <% if (!orders.length) { %><p class="muted">No orders yet.</p><% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
        <tbody><% orders.forEach((o) => { %><tr><td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td><td><%= h.formatDate(o.created_at) %></td><td><%= money(o.total) %></td><td><span class="pill pill-<%= o.status %>"><%= o.status %></span></td></tr><% }) %></tbody>
      </table></div>
      <% } %>
    </section>
  </div>
  <aside class="form-side">
    <section class="card">
      <h2>Contact</h2>
      <p><a href="mailto:<%= c.email %>"><%= c.email %></a><br><%= c.phone || '' %></p>
      <% if (c.address_line1) { %><h2>Address</h2><address><%= c.address_line1 %><br><% if (c.address_line2) { %><%= c.address_line2 %><br><% } %><%= c.city %>, <%= c.state %> <%= c.pincode %></address><% } %>
      <% if (wishlist.length) { %><h2>Wishlist</h2><ul class="plain"><% wishlist.forEach((w) => { %><li><a href="/admin/products/<%= w.id %>/edit"><%= w.name %></a></li><% }) %></ul><% } %>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
