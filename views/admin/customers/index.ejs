<%- include('../partials/top') %>
<div class="page-head"><div><h1>Customers</h1><p class="muted"><%= pager.total %> registered · <%= guests %> guest checkout email<%= guests === 1 ? '' : 's' %></p></div></div>
<form class="filters" method="get"><input type="search" name="q" placeholder="Name, email or phone" value="<%= query.q || '' %>"><button class="btn" type="submit">Search</button></form>
<% if (!customers.length) { %>
  <div class="card empty"><h2>No customers yet</h2><p>Customers who create an account appear here.</p></div>
<% } else { %>
<div class="card flush"><div class="table-wrap"><table class="table">
  <thead><tr><th>Name</th><th>Contact</th><th>Orders</th><th>Total spent</th><th>Last order</th><th>Joined</th></tr></thead>
  <tbody>
    <% customers.forEach((c) => { %>
      <tr>
        <td><a href="/admin/customers/<%= c.id %>"><strong><%= c.name %></strong></a></td>
        <td><%= c.email %><br><small class="muted"><%= c.phone || '' %></small></td>
        <td><%= c.order_count %></td>
        <td><%= money(c.spent) %></td>
        <td><%= c.last_order ? h.formatDate(c.last_order) : '—' %></td>
        <td><%= h.formatDate(c.created_at) %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div></div>
<%- include('../../partials/pagination') %>
<% } %>
<%- include('../partials/bottom') %>
