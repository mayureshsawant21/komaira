<%- include('../partials/top') %>
<% const o = order; %>
<div class="page-head">
  <div>
    <a href="/admin/orders" class="back">← Orders</a>
    <h1><%= o.order_number %> <span class="pill pill-<%= o.status %>"><%= o.status %></span></h1>
    <p class="muted">Placed <%= h.formatDate(o.created_at, true) %></p>
  </div>
  <div class="actions"><a href="/admin/orders/<%= o.id %>/invoice" target="_blank" class="btn">Print invoice / packing slip</a></div>
</div>

<div class="form-layout">
  <div class="form-main">
    <section class="card">
      <h2>Items</h2>
      <div class="table-wrap"><table class="table">
        <thead><tr><th></th><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          <% o.items.forEach((i) => { %>
            <tr>
              <td class="thumb-cell"><% if (i.image) { %><img src="<%= i.image %>" alt=""><% } else { %><span class="thumb-ph"><%= i.name.charAt(0) %></span><% } %></td>
              <td><% if (i.product_id) { %><a href="/admin/products/<%= i.product_id %>/edit"><%= i.name %></a><% } else { %><%= i.name %><% } %><% if (i.variant_name) { %><br><small class="muted"><%= i.variant_name %></small><% } %><% if (i.sku) { %><br><small class="muted">SKU <%= i.sku %></small><% } %></td>
              <td><%= money(i.price) %></td>
              <td><%= i.quantity %></td>
              <td><%= money(i.total) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <dl class="totals">
        <div><dt>Subtotal</dt><dd><%= money(o.subtotal) %></dd></div>
        <% if (o.discount) { %><div><dt>Discount <%= o.coupon_code ? `(${o.coupon_code})` : '' %></dt><dd>−<%= money(o.discount) %></dd></div><% } %>
        <div><dt>Shipping</dt><dd><%= o.shipping ? money(o.shipping) : 'Free' %></dd></div>
        <div class="grand"><dt>Total</dt><dd><%= money(o.total) %></dd></div>
      </dl>
    </section>

    <section class="card">
      <h2>Timeline</h2>
      <ol class="timeline">
        <% o.events.slice().reverse().forEach((e) => { %>
          <li><span class="pill pill-<%= e.status %>"><%= e.status %></span> <%= e.note || '' %> <small class="muted"><%= h.formatDate(e.created_at, true) %></small></li>
        <% }) %>
      </ol>
    </section>
  </div>

  <aside class="form-side">
    <form class="card" action="/admin/orders/<%= o.id %>" method="post">
      <h2>Update order</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Order status</span>
        <select name="status"><% statuses.forEach((s) => { %><option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option><% }) %></select>
        <small>Cancelling puts the items back in stock.</small>
      </label>
      <label class="field"><span>Payment status</span>
        <select name="payment_status"><% paymentStatuses.forEach((s) => { %><option value="<%= s %>" <%= o.payment_status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option><% }) %></select>
      </label>
      <div class="field-row">
        <label class="field"><span>Courier</span><input name="courier" value="<%= o.courier || '' %>" placeholder="Delhivery, Blue Dart…"></label>
        <label class="field"><span>Tracking no.</span><input name="tracking_number" value="<%= o.tracking_number || '' %>"></label>
      </div>
      <label class="field"><span>Note for timeline (optional)</span><input name="note" maxlength="300"></label>
      <label class="field"><span>Private notes</span><textarea name="admin_notes" rows="2"><%= o.admin_notes || '' %></textarea></label>
      <label class="check big"><input type="checkbox" name="notify" checked> Email the customer about status changes</label>
      <button class="btn btn-primary btn-block mt" type="submit">Save changes</button>
    </form>

    <section class="card">
      <h2>Customer</h2>
      <p><strong><%= o.name %></strong><br>
        <a href="mailto:<%= o.email %>"><%= o.email %></a><br>
        <a href="tel:<%= o.phone %>"><%= o.phone %></a>
        <% if (o.phone) { %> · <a href="https://wa.me/<%= o.phone.replace(/\D/g, '').replace(/^(\d{10})$/, '91$1') %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
      </p>
      <% if (o.customer_id) { %><p><a href="/admin/customers/<%= o.customer_id %>">View customer profile</a> · <%= customerOrders %> order<%= customerOrders === 1 ? '' : 's' %></p><% } else { %><p class="muted small">Guest checkout</p><% } %>
      <h2>Shipping address</h2>
      <address><%= o.address_line1 %><br><% if (o.address_line2) { %><%= o.address_line2 %><br><% } %><%= o.city %>, <%= o.state %> <%= o.pincode %><br><%= o.country %></address>
      <% if (o.notes) { %><h2>Customer note</h2><p><%= o.notes %></p><% } %>
      <h2>Payment</h2>
      <p><%= o.payment_method === 'cod' ? 'Cash on Delivery' : 'Online (Razorpay)' %><% if (o.payment_ref) { %><br><small class="muted">Ref: <%= o.payment_ref %></small><% } %></p>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
