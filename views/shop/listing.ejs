<%- include('../partials/head') %>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <% if (category) { %>
        <a href="/shop">Shop</a><span>/</span>
        <% if (category.parent) { %><a href="/category/<%= category.parent.slug %>"><%= category.parent.name %></a><span>/</span><% } %>
        <span aria-current="page"><%= category.name %></span>
      <% } else { %><span aria-current="page">Shop</span><% } %>
    </nav>
    <h1 class="page-title"><%= heading %></h1>
    <% if (intro) { %><p class="page-intro"><%= intro %></p><% } %>
    <% if (subcategories.length) { %>
      <div class="chip-row">
        <% subcategories.forEach((sc) => { %><a class="chip" href="/category/<%= sc.slug %>"><%= sc.name %></a><% }) %>
      </div>
    <% } else if (!category && !filters.q) { %>
      <div class="chip-row">
        <% navCategories.forEach((c) => { %><a class="chip" href="/category/<%= c.slug %>"><%= c.name %></a><% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="container listing">
  <form class="toolbar" method="get" data-autosubmit>
    <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>
    <span class="result-count"><%= pager.total %> product<%= pager.total === 1 ? '' : 's' %></span>
    <div class="toolbar-filters">
      <label class="check-pill"><input type="checkbox" name="stock" value="1" <%= filters.inStock ? 'checked' : '' %>> In stock</label>
      <label class="check-pill"><input type="checkbox" name="sale" value="1" <%= filters.onSale ? 'checked' : '' %>> On sale</label>
      <div class="price-filter">
        <label class="sr-only" for="min">Minimum price</label>
        <input id="min" type="number" name="min" min="0" placeholder="Min <%= settings.currency_symbol %>" value="<%= query.min || '' %>">
        <span>–</span>
        <label class="sr-only" for="max">Maximum price</label>
        <input id="max" type="number" name="max" min="0" placeholder="Max <%= settings.currency_symbol %>" value="<%= query.max || '' %>">
        <button type="submit" class="btn btn-sm btn-outline">Go</button>
      </div>
      <label class="select-wrap">
        <span class="sr-only">Sort by</span>
        <select name="sort">
          <% [['featured', 'Featured'], ['popular', 'Bestselling'], ['newest', 'Newest'], ['price_asc', 'Price: low to high'], ['price_desc', 'Price: high to low'], ['name', 'Name A–Z']].forEach(([v, l]) => { %>
            <option value="<%= v %>" <%= (filters.sort || 'featured') === v ? 'selected' : '' %>><%= l %></option>
          <% }) %>
        </select>
      </label>
    </div>
  </form>

  <% if (products.length) { %>
    <div class="product-grid">
      <% products.forEach((product) => { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
    <%- include('../partials/pagination') %>
  <% } else { %>
    <div class="empty-state">
      <%- include('../partials/icon', { name: 'search', size: 36 }) %>
      <h2>No products found</h2>
      <p>Try removing a filter or searching for something else.</p>
      <a href="/shop" class="btn btn-outline">Browse all products</a>
    </div>
  <% } %>
</section>

<%- include('../partials/foot') %>
