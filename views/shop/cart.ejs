<%- include('../partials/head') %>

<section class="container narrow-top">
  <h1 class="page-title">Your bag</h1>

  <% if (cart.notices.length) { %>
    <div class="notice"><% cart.notices.forEach((n) => { %><p><%= n %></p><% }) %></div>
  <% } %>

  <% if (!cart.lines.length) { %>
    <div class="empty-state">
      <%- include('../partials/icon', { name: 'bag', size: 40 }) %>
      <h2>Your bag is empty</h2>
      <p>Let's find something you'll love.</p>
      <a href="/shop" class="btn btn-primary">Start shopping</a>
    </div>
  <% } else { %>
  <div class="cart-layout">
    <div class="cart-lines">
      <% if (cart.freeShippingRemaining > 0) { %>
        <div class="ship-progress">
          <p>You're <strong><%= money(cart.freeShippingRemaining) %></strong> away from free shipping</p>
          <div class="bar"><span style="width: <%= Math.min(100, Math.round(((cart.freeShippingThreshold - cart.freeShippingRemaining) / cart.freeShippingThreshold) * 100)) %>%"></span></div>
        </div>
      <% } else if (cart.freeShippingThreshold > 0) { %>
        <div class="ship-progress is-done"><p><%- include('../partials/icon', { name: 'check', size: 16 }) %> You've unlocked free shipping!</p></div>
      <% } %>

      <% cart.lines.forEach((l) => { %>
        <article class="cart-line">
          <a href="/product/<%= l.slug %>" class="cart-thumb">
            <% if (l.image) { %><img src="<%= l.image %>" alt=""><% } else { %><span class="img-placeholder"><span><%= l.name.charAt(0) %></span></span><% } %>
          </a>
          <div class="cart-info">
            <a href="/product/<%= l.slug %>" class="cart-name"><%= l.name %></a>
            <% if (l.variantName) { %><span class="muted"><%= l.variantLabel %>: <%= l.variantName %></span><% } %>
            <span class="cart-unit"><%= money(l.price) %><% if (l.compareAt && l.compareAt > l.price) { %> <s class="price-compare"><%= money(l.compareAt) %></s><% } %></span>
            <div class="cart-actions">
              <form action="/cart/update" method="post" class="qty qty-sm" data-qty data-autosubmit>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="index" value="<%= l.index %>">
                <button type="button" aria-label="Decrease quantity" data-step="-1"><%- include('../partials/icon', { name: 'minus', size: 14 }) %></button>
                <input type="number" name="qty" value="<%= l.qty %>" min="0" max="<%= Math.min(l.stock, 10) %>" aria-label="Quantity for <%= l.name %>">
                <button type="button" aria-label="Increase quantity" data-step="1"><%- include('../partials/icon', { name: 'plus', size: 14 }) %></button>
              </form>
              <form action="/cart/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="index" value="<%= l.index %>">
                <button type="submit" class="link-btn muted"><%- include('../partials/icon', { name: 'trash', size: 16 }) %> Remove</button>
              </form>
            </div>
          </div>
          <strong class="cart-total"><%= money(l.total) %></strong>
        </article>
      <% }) %>
    </div>

    <aside class="summary card">
      <h2>Order summary</h2>
      <%- include('../partials/coupon', { back: 'cart' }) %>
      <dl class="totals">
        <div><dt>Subtotal</dt><dd><%= money(cart.subtotal) %></dd></div>
        <% if (cart.discount) { %><div class="discount"><dt>Discount (<%= cart.coupon.code %>)</dt><dd>−<%= money(cart.discount) %></dd></div><% } %>
        <div><dt>Shipping</dt><dd><%= cart.shipping ? money(cart.shipping) : 'Free' %></dd></div>
        <div class="grand"><dt>Total</dt><dd><%= money(cart.total) %></dd></div>
      </dl>
      <a href="/checkout" class="btn btn-primary btn-lg btn-block">Checkout securely</a>
      <a href="/shop" class="btn-link-center">Continue shopping</a>
    </aside>
  </div>
  <% } %>
</section>

<%- include('../partials/foot') %>
