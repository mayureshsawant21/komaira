<%- include('../partials/head') %>
<%
  const steps = ['confirmed', 'processing', 'shipped', 'delivered'];
  const currentStep = order.status === 'pending' ? -1 : steps.indexOf(order.status);
%>
<section class="container narrow-top order-page">
  <% if (justPlaced) { %>
    <div class="thanks">
      <span class="thanks-icon"><%- include('../partials/icon', { name: 'check', size: 30 }) %></span>
      <h1 class="page-title">Thank you, <%= order.name.split(' ')[0] %>!</h1>
      <p>Your order <strong><%= order.order_number %></strong> has been placed. A confirmation has been sent to <%= order.email %>.</p>
    </div>
  <% } else { %>
    <h1 class="page-title">Order <%= order.order_number %></h1>
    <p class="muted">Placed on <%= h.formatDate(order.created_at, true) %></p>
  <% } %>

  <% if (order.status === 'cancelled') { %>
    <div class="notice">This order was cancelled. If you have questions, please <a href="/contact">contact us</a>.</div>
  <% } else { %>
    <ol class="tracker">
      <% steps.forEach((s, i) => { %>
        <li class="<%= i <= currentStep ? 'is-done' : '' %><%= i === currentStep ? ' is-current' : '' %>"><span></span><%= s.charAt(0).toUpperCase() + s.slice(1) %></li>
      <% }) %>
    </ol>
    <% if (order.payment_method === 'razorpay' && order.payment_status !== 'paid') { %>
      <div class="notice">Payment pending. <a href="/checkout/pay/<%= encodeURIComponent(order.order_number) %>?t=<%= order.access_token %>">Complete payment</a></div>
    <% } %>
    <% if (order.tracking_number) { %>
      <div class="notice notice-info"><%- include('../partials/icon', { name: 'truck', size: 18 }) %> Shipped via <strong><%= order.courier || 'courier' %></strong> · Tracking number: <strong><%= order.tracking_number %></strong></div>
    <% } %>
  <% } %>

  <div class="order-grid">
    <div class="card">
      <h2>Items</h2>
      <ul class="summary-lines">
        <% order.items.forEach((i) => { %>
          <li>
            <span class="summary-thumb">
              <% if (i.image) { %><img src="<%= i.image %>" alt=""><% } else { %><span class="img-placeholder"><span><%= i.name.charAt(0) %></span></span><% } %>
              <span class="qty-badge"><%= i.quantity %></span>
            </span>
            <span class="summary-name"><%= i.name %><% if (i.variant_name) { %><small><%= i.variant_name %></small><% } %></span>
            <span><%= money(i.total) %></span>
          </li>
        <% }) %>
      </ul>
      <dl class="totals">
        <div><dt>Subtotal</dt><dd><%= money(order.subtotal) %></dd></div>
        <% if (order.discount) { %><div class="discount"><dt>Discount<%= order.coupon_code ? ` (${order.coupon_code})` : '' %></dt><dd>−<%= money(order.discount) %></dd></div><% } %>
        <div><dt>Shipping</dt><dd><%= order.shipping ? money(order.shipping) : 'Free' %></dd></div>
        <div class="grand"><dt>Total</dt><dd><%= money(order.total) %></dd></div>
      </dl>
    </div>
    <div class="card">
      <h2>Delivery</h2>
      <address>
        <strong><%= order.name %></strong><br>
        <%= order.address_line1 %><br>
        <% if (order.address_line2) { %><%= order.address_line2 %><br><% } %>
        <%= order.city %>, <%= order.state %> <%= order.pincode %><br>
        <%= order.phone %>
      </address>
      <h2>Payment</h2>
      <p><%= order.payment_method === 'cod' ? 'Cash on Delivery' : 'Online payment' %> · <span class="status status-<%= order.payment_status %>"><%= order.payment_status %></span></p>
    </div>
  </div>
  <div class="center-block"><a href="/shop" class="btn btn-outline">Continue shopping</a></div>
</section>
<%- include('../partials/foot') %>
