<%- include('../partials/head') %>

<section class="hero" aria-roledescription="carousel" aria-label="Offers and announcements" data-slider data-autoplay="<%= Number(settings.banner_autoplay_seconds) || 0 %>">
  <div class="hero-track">
    <% if (!banners.length) { %>
      <div class="slide is-active text-dark align-left" style="--slide-bg: #f3e6e1">
        <div class="slide-art" aria-hidden="true"></div>
        <div class="container slide-content">
          <span class="eyebrow">Welcome to <%= settings.store_name %></span>
          <h1 class="slide-title">Beauty, thoughtfully curated.</h1>
          <p class="slide-sub">Discover skincare and makeup essentials chosen for how they make you feel.</p>
          <a href="/shop" class="btn btn-primary btn-lg">Shop now <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
        </div>
      </div>
    <% } %>
    <% banners.forEach((b, i) => { %>
      <div class="slide text-<%= b.text_theme %> align-<%= b.align %><%= i === 0 ? ' is-active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= banners.length %>" style="--slide-bg: <%= b.bg_color || '#f3e6e1' %>" <%= i === 0 ? '' : 'aria-hidden=true' %>>
        <% if (b.image) { %>
          <picture class="slide-media">
            <% if (b.mobile_image) { %><source media="(max-width: 700px)" srcset="<%= b.mobile_image %>"><% } %>
            <img src="<%= b.image %>" alt="" <%= i === 0 ? 'fetchpriority=high' : 'loading=lazy' %>>
          </picture>
        <% } else { %>
          <div class="slide-art" aria-hidden="true"></div>
        <% } %>
        <div class="container slide-content">
          <% if (b.eyebrow) { %><span class="eyebrow"><%= b.eyebrow %></span><% } %>
          <<%= i === 0 ? 'h1' : 'h2' %> class="slide-title"><%= b.title %></<%= i === 0 ? 'h1' : 'h2' %>>
          <% if (b.subtitle) { %><p class="slide-sub"><%= b.subtitle %></p><% } %>
          <% if (b.cta_text && b.cta_link) { %>
            <a href="<%= b.cta_link %>" class="btn <%= b.text_theme === 'light' ? 'btn-light' : 'btn-primary' %> btn-lg" <%= i === 0 ? '' : 'tabindex=-1' %>><%= b.cta_text %> <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
  <% if (banners.length > 1) { %>
    <button class="slider-arrow prev" type="button" aria-label="Previous slide" data-prev><%- include('../partials/icon', { name: 'chevron-left', size: 22 }) %></button>
    <button class="slider-arrow next" type="button" aria-label="Next slide" data-next><%- include('../partials/icon', { name: 'chevron-right', size: 22 }) %></button>
    <div class="slider-dots" role="tablist" aria-label="Choose slide">
      <% banners.forEach((b, i) => { %>
        <button type="button" role="tab" class="<%= i === 0 ? 'is-active' : '' %>" aria-label="Slide <%= i + 1 %>" aria-selected="<%= i === 0 %>" data-dot="<%= i %>"><span></span></button>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="promises" aria-label="Why shop with us">
  <div class="container promises-grid">
    <% [['truck', settings.promise_1], ['shield', settings.promise_2], ['refresh', settings.promise_3], ['lock', settings.promise_4]].forEach(([icon, text]) => { if (!text) return; %>
      <div class="promise"><%- include('../partials/icon', { name: icon, size: 22 }) %><span><%= text %></span></div>
    <% }) %>
  </div>
</section>

<% if (homeCategories.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Shop by category</h2>
      <a href="/shop" class="link-arrow">View all <%- include('../partials/icon', { name: 'arrow-right', size: 16 }) %></a>
    </div>
    <div class="category-grid">
      <% homeCategories.forEach((c, i) => { %>
        <a href="/category/<%= c.slug %>" class="category-card">
          <span class="category-img tone-<%= i % 4 %>">
            <% if (c.image) { %><img src="<%= c.image %>" alt="" loading="lazy"><% } else { %><span class="category-initial"><%= c.name.charAt(0) %></span><% } %>
          </span>
          <span class="category-name"><%= c.name %></span>
          <span class="category-count"><%= c.product_count %> product<%= c.product_count === 1 ? '' : 's' %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (featured.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= settings.home_featured_title || 'Bestsellers' %></h2>
      <a href="/shop?sort=popular" class="link-arrow">Shop all <%- include('../partials/icon', { name: 'arrow-right', size: 16 }) %></a>
    </div>
    <div class="product-grid">
      <% featured.forEach((product) => { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (onSale.length) { %>
<section class="section section-tint">
  <div class="container offer-split">
    <div class="offer-copy">
      <span class="eyebrow">Limited time</span>
      <h2 class="section-title">Offers you'll love</h2>
      <p>Hand-picked favourites at special prices — while stocks last.</p>
      <a href="/shop?sale=1" class="btn btn-primary">Shop offers</a>
    </div>
    <div class="product-grid product-grid-compact">
      <% onSale.forEach((product) => { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (newest.length && featured !== newest) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= settings.home_new_title || 'New arrivals' %></h2>
      <a href="/shop?sort=newest" class="link-arrow">See what's new <%- include('../partials/icon', { name: 'arrow-right', size: 16 }) %></a>
    </div>
    <div class="product-grid">
      <% newest.forEach((product) => { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (!featured.length && !newest.length) { %>
<section class="section">
  <div class="container empty-state">
    <%- include('../partials/icon', { name: 'sparkle', size: 36 }) %>
    <h2>Our shelves are being stocked</h2>
    <p>New products are arriving soon. Join our list below to hear first.</p>
  </div>
</section>
<% } %>

<% if (reviews.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="section-title center">Loved by our customers</h2>
    <div class="testimonials">
      <% reviews.forEach((r) => { %>
        <figure class="testimonial">
          <div class="stars" aria-label="<%= r.rating %> out of 5 stars"><% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= r.rating ? 'on' : '' %>"><%- include('../partials/icon', { name: 'star', size: 16 }) %></span><% } %></div>
          <blockquote>“<%= h.truncate(r.body, 220) %>”</blockquote>
          <figcaption><strong><%= r.name %></strong> on <a href="/product/<%= r.product_slug %>"><%= r.product_name %></a></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/foot') %>
