<%- include('../partials/head') %>

<section class="container narrow-top">
  <h1 class="page-title">Checkout</h1>
  <% if (!customer) { %>
    <p class="muted checkout-login">Have an account? <a href="/account/login?next=/checkout">Sign in</a> for faster checkout — or continue as a guest.</p>
  <% } %>

  <div class="cart-layout">
    <form action="/checkout" method="post" class="checkout-form" id="checkout-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <fieldset class="card">
        <legend>Contact</legend>
        <div class="form-grid">
          <label class="field"><span>Full name</span><input name="name" required autocomplete="name" value="<%= form.name || '' %>"></label>
          <label class="field"><span>Mobile number</span><input name="phone" type="tel" required autocomplete="tel" inputmode="numeric" placeholder="10-digit mobile" value="<%= form.phone || '' %>"></label>
        </div>
        <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email" value="<%= form.email || '' %>"></label>
      </fieldset>

      <fieldset class="card">
        <legend>Delivery address</legend>
        <label class="field"><span>House / flat, street</span><input name="address_line1" required autocomplete="address-line1" value="<%= form.address_line1 || '' %>"></label>
        <label class="field"><span>Area, landmark <em>(optional)</em></span><input name="address_line2" autocomplete="address-line2" value="<%= form.address_line2 || '' %>"></label>
        <div class="form-grid form-grid-3">
          <label class="field"><span>City</span><input name="city" required autocomplete="address-level2" value="<%= form.city || '' %>"></label>
          <label class="field"><span>State</span>
            <select name="state" required autocomplete="address-level1">
              <option value="">Select state</option>
              <% states.forEach((s) => { %><option <%= form.state === s ? 'selected' : '' %>><%= s %></option><% }) %>
            </select>
          </label>
          <label class="field"><span>PIN code</span><input name="pincode" required inputmode="numeric" maxlength="6" autocomplete="postal-code" value="<%= form.pincode || '' %>"></label>
        </div>
        <label class="field"><span>Order notes <em>(optional)</em></span><textarea name="notes" rows="2" placeholder="Anything we should know about delivery?"><%= form.notes || '' %></textarea></label>
      </fieldset>

      <fieldset class="card">
        <legend>Payment</legend>
        <div class="pay-options">
          <% payments.forEach((p) => { %>
            <label class="pay-option">
              <input type="radio" name="payment_method" value="<%= p.value %>" <%= form.payment_method === p.value ? 'checked' : '' %>>
              <span>
                <strong><%= p.label %><% if (p.fee) { %> <em>(+<%= money(p.fee) %>)</em><% } %></strong>
                <small><%= p.hint %></small>
              </span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-primary btn-lg btn-block show-sm">Place order · <%= money(cart.total) %></button>
    </form>

    <aside class="summary card">
      <h2>Your order</h2>
      <ul class="summary-lines">
        <% cart.lines.forEach((l) => { %>
          <li>
            <span class="summary-thumb">
              <% if (l.image) { %><img src="<%= l.image %>" alt=""><% } else { %><span class="img-placeholder"><span><%= l.name.charAt(0) %></span></span><% } %>
              <span class="qty-badge"><%= l.qty %></span>
            </span>
            <span class="summary-name"><%= l.name %><% if (l.variantName) { %><small><%= l.variantName %></small><% } %></span>
            <span><%= money(l.total) %></span>
          </li>
        <% }) %>
      </ul>
      <%- include('../partials/coupon', { back: 'checkout' }) %>
      <dl class="totals">
        <div><dt>Subtotal</dt><dd><%= money(cart.subtotal) %></dd></div>
        <% if (cart.discount) { %><div class="discount"><dt>Discount (<%= cart.coupon.code %>)</dt><dd>−<%= money(cart.discount) %></dd></div><% } %>
        <div><dt>Shipping</dt><dd><%= cart.shipping ? money(cart.shipping) : 'Free' %></dd></div>
        <div class="grand"><dt>Total</dt><dd><%= money(cart.total) %></dd></div>
      </dl>
      <button type="submit" form="checkout-form" class="btn btn-primary btn-lg btn-block hide-sm">Place order</button>
      <p class="secure-note"><%- include('../partials/icon', { name: 'lock', size: 14 }) %> Your details are protected and never shared.</p>
    </aside>
  </div>
</section>

<%- include('../partials/foot') %>
